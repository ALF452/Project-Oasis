<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Gun-barrel O: a slim ring standing in for the letterform, with
         narrower rings nested inside it receding toward a bright point —
         the Bond gun-barrel tunnel shot, not a crosshair. -->

    <!-- Faint ambient bloom just outside the ring, thin so it reads as
         glow rather than adding bulk to the ring itself -->
    <path
        android:pathData="M23,54 A31,31 0 1 1 85,54 A31,31 0 1 1 23,54"
        android:strokeColor="#2600E5FF"
        android:strokeWidth="5"
        android:fillColor="#00000000" />

    <!-- The O itself -->
    <path
        android:pathData="M23,54 A31,31 0 1 1 85,54 A31,31 0 1 1 23,54"
        android:strokeColor="#00E5FF"
        android:strokeWidth="3"
        android:fillColor="#00000000" />

    <!-- Receding tunnel rings, each dimmer and smaller than the last -->
    <path
        android:pathData="M29,54 A25,25 0 1 1 79,54 A25,25 0 1 1 29,54"
        android:strokeColor="#CC00E5FF"
        android:strokeWidth="2"
        android:fillColor="#00000000" />
    <path
        android:pathData="M35,54 A19,19 0 1 1 73,54 A19,19 0 1 1 35,54"
        android:strokeColor="#9900E5FF"
        android:strokeWidth="2"
        android:fillColor="#00000000" />
    <path
        android:pathData="M41,54 A13,13 0 1 1 67,54 A13,13 0 1 1 41,54"
        android:strokeColor="#7300E5FF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000" />
    <path
        android:pathData="M46,54 A8,8 0 1 1 62,54 A8,8 0 1 1 46,54"
        android:strokeColor="#4D00E5FF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000" />
    <path
        android:pathData="M49,54 A5,5 0 1 1 59,54 A5,5 0 1 1 49,54"
        android:strokeColor="#3800E5FF"
        android:strokeWidth="1"
        android:fillColor="#00000000" />

    <!-- The point at the end of the tunnel, kept in the same blue as every
         ring rather than breaking to white -->
    <path
        android:pathData="M54,54 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0"
        android:fillColor="#00E5FF" />
</vector>
